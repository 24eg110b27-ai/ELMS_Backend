# Copy to .env for local runs; Spring Boot imports .env, but the host must set these variables separately.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/<DATABASE>?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=<USERNAME>
SPRING_DATASOURCE_PASSWORD=<PASSWORD>
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://elmsfrontend.onrender.com,http://localhost:5173,http://127.0.0.1:5173
