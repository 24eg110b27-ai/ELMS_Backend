# Copy to .env for local runs; Spring Boot imports .env, but the host must set these variables separately.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DATABASE>?ssl-mode=REQUIRED
SPRING_DATASOURCE_USERNAME=<AIVEN_USERNAME>
SPRING_DATASOURCE_PASSWORD=<AIVEN_PASSWORD>
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://elmsfrontend-nwlosr9jo-csk-8cda.vercel.app,http://localhost:5173,http://127.0.0.1:5173